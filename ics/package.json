{
  "name": "ics-motion",
  "version": "1.0.0",
  "private": true,
  "description": "ICS Soluções Comerciais — motion design interativo da marca (composição HyperFrames + player Node.js)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "studio": "hyperframes preview",
    "check": "hyperframes check",
